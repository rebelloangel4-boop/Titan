# Set values through a server secret manager or chmod-600 environment file.
# This file is NOT loaded automatically by Python.
TITAN_TOKEN=
TITAN_DB=/var/lib/titan/titan.db
TITAN_DAILY_USD=0
TITAN_DAILY_CALLS=50
# Empty by default. Set only AFTER checking your selected models' free quota.
TITAN_FREE_PROVIDERS=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# Override inherited model IDs after checking your account's currently available models.
# TITAN_MODEL_GEMINI=...
# TITAN_MODEL_GROQ=...
# TITAN_MAX_CALL_USD_OPENAI=0.05
TITAN_GITHUB_REPOSITORY=rebelloangel4-boop/titan-ai
GITHUB_TOKEN=
GOOGLE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TITAN_TELEGRAM_CHAT_ID=
TITAN_WEB_HOSTS=
TITAN_MCP_URL=
TITAN_MCP_HOSTS=
TITAN_MCP_TOOLS=
TITAN_MCP_TOKEN=
TITAN_ENABLE_SANDBOX=0
TITAN_SANDBOX_IMAGE=

# Optional local OpenAI-compatible inference (no model weights included).
TITAN_LOCAL_ENABLED=0
TITAN_LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions
TITAN_MODEL_LOCAL=
TITAN_ARTIFACT_DIR=/var/lib/titan/artifacts
TITAN_ARTIFACT_BYTES=250000000
# Docker Compose mounts TITAN_TOKEN_FILE; leave TITAN_TOKEN empty.
# Provider credentials may also use e.g. GROQ_API_KEY_FILE=/run/secrets/groq_key.

# Optional Drive refresh-token credentials; prefer corresponding _FILE sources.
# Initial Google OAuth consent must be completed by the operator.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional local semantic retrieval; provision the pinned model first (docs/SEMANTIC_MEMORY.md).
TITAN_MEMORY_MODE=lexical
